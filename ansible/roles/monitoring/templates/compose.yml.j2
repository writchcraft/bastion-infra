# {{ ansible_managed }}
#
# Both services use host networking and bind explicit addresses, so no port
# is published through Docker's iptables rules (which would bypass UFW).
name: bastion-monitoring

services:
  prometheus:
    image: {{ monitoring_prometheus_image }}
    container_name: prometheus
    network_mode: host
    user: "{{ monitoring_prometheus_uid }}:{{ monitoring_prometheus_uid }}"
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ monitoring_prometheus_retention }}
      - --web.listen-address={{ monitoring_prometheus_listen }}
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - {{ monitoring_data_dir }}/prometheus:/prometheus
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "{{ monitoring_prometheus_url }}/-/ready"]
      interval: 30s
      timeout: 5s
      retries: 3
    restart: unless-stopped

  grafana:
    image: {{ monitoring_grafana_image }}
    container_name: grafana
    network_mode: host
    user: "{{ monitoring_grafana_uid }}"
    env_file: grafana.env
    environment:
      GF_SERVER_HTTP_ADDR: "{{ monitoring_grafana_listen_address }}"
      GF_SERVER_HTTP_PORT: "{{ monitoring_grafana_port }}"
{% if monitoring_domain %}
      GF_SERVER_DOMAIN: "{{ monitoring_domain }}"
      GF_SERVER_ROOT_URL: "https://{{ monitoring_domain }}/"
{% endif %}
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/etc/grafana/dashboards:ro
      - {{ monitoring_data_dir }}/grafana:/var/lib/grafana
    depends_on:
      - prometheus
    restart: unless-stopped
