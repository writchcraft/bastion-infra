// {{ ansible_managed }}
//
// Overrides for Ubuntu's 50unattended-upgrades. Allowed origins are left at
// the Ubuntu default (the -security pocket).
Unattended-Upgrade::Automatic-Reboot "{{ 'true' if security_auto_reboot | bool else 'false' }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ security_auto_reboot_time }}";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::SyslogEnable "true";
